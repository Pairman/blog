---
import { colorBaseClasses, colorAccentClasses } from "src/colors";
import { ACCENT_COLOR, BASE_COLOR } from "../config.ts";

const { class: className } = Astro.props;
---

<div
  class:list={[
    "prose prose-img:rounded-xl dark:prose-invert prose-a:underline prose-a:decoration-dashed prose-a:underline-offset-4 hover:prose-a:decoration-solid prose-headings:text-white prose-p:text-white prose-li:text-white prose-strong:text-white prose-blockquote:text-white prose-code:text-white",
    "prose-inline-code:bg-base-100 dark:prose-inline-code:bg-base-800 prose-inline-code:p-1 prose-inline-code:rounded-md",
    colorBaseClasses[BASE_COLOR],
    colorAccentClasses[ACCENT_COLOR],
    className,
  ]}
>
  <slot />
</div>
