---
import BaseHead from "../components/BaseHead.astro";
const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark h-full antialiased">
  <head>
    <BaseHead title={title} description={description} image={image} />

    <style is:global>
      html.dark .astro-code,
      html.dark .astro-code span {
        color: var(--shiki-dark);
      }

      html:not(dark) .astro-code,
      html:not(dark) .astro-code span {
        color: var(--shiki-light);
      }

      pre {
        @apply overflow-x-auto !important;
        white-space: pre;
        @apply border border-base-700 bg-black rounded-xl !important;
      }

      .astro-code {
        counter-reset: line;
      }

      .astro-code .line::before {
        counter-increment: line;
        content: counter(line);
        display: inline-block;
        width: 2.5em;
        margin-right: 1em;
        color: rgb(156 163 175);
        text-align: right;
        user-select: none;
      }

      .line.highlighted {
        margin: 0 -24px;
        padding: 0 24px;
        position: relative;

        display: inline-block;
        width: calc(100% + 48px);
      }
      .line.highlighted {
        @apply bg-accent-700/10;
      }

      ::selection {
        @apply bg-accent-900/40;
      }

      lite-youtube {
        @apply rounded-xl border border-base-300 dark:border-base-700;
      }

      .prose mark {
        @apply bg-accent-900 text-white;
      }
      .MathJax svg {
        display: inline !important;
      }
    </style>
  </head>

  <body
    class="bg-black flex mx-1 sm:mx-4"
  >
    <div class="max-w-4xl mx-auto my-1 sm:my-8 w-full">
      <div class="w-full">
        <slot />
      </div>
    </div>

  </body>
</html>
