---
import { type CollectionEntry, render } from "astro:content";
import BaseLayout from "$layouts/BaseLayout.astro";
import BlogPost from "$layouts/BlogPost.astro";
import Header from "$components/Header.astro";
import Footer from "$components/Footer.astro";
import FormattedDate from "$components/FormattedDate.astro";
import { getBlogPosts } from "src/utils";
import Tag from "$components/Tag.astro";

export async function getStaticPaths() {
  const posts = await getBlogPosts(true);
  return posts.map((post: any) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<BaseLayout {...post.data} image={post.id + ".png"}>
  <Header />

  <main class="max-w-2xl lg:max-w-3xl mx-auto my-0 h-full p-4">
    <BlogPost>
      <div
        class="flex mt-8 gap-4 text-xs text-base-500 items-center"
      >
        <div class="shrink-0">
          <FormattedDate date={post.data.pubDate} />
        </div>
        <div class="flex flex-wrap gap-x-1">
          {post.data.tags?.map((tag: string) => <Tag {tag} />)}
        </div>
      </div>

      <h1 id="article-title" class="mt-4">{post.data.title}</h1>
      <Content />
    </BlogPost>
  </main>
  <Footer />
</BaseLayout>
