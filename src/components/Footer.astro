---
import { BASE, LICENSE, NAME, SOCIAL_LINKS, SOURCE_LINK } from "../config.ts";

const today = new Date();
const { showBorder = false } = Astro.props;
---

<footer>
  <div
    class:list={[
      "mx-auto max-w-7xl px-6 pt-12 mt-12 pb-12 md:flex md:items-center md:justify-between lg:px-16",
      { "border-t border-base-200 dark:border-base-800": showBorder },
    ]}
  >
    <div class="flex justify-center items-center gap-x-6 text-sm/6 font-normal text-base-500 [&_a]:!text-base-500 hover:[&_a]:!text-base-200 md:order-2">
      <a href={BASE + "/about"}>ABOUT</a>
      {SOCIAL_LINKS.GITHUB_URL ? (
        <a target="_blank" href={SOCIAL_LINKS.GITHUB_URL}>
          <span aria-label="GitHub">GITHUB</span>
        </a>
      ) : null}
      {SOCIAL_LINKS.EMAIL ? (
        <a target="_blank" href={`mailto:${SOCIAL_LINKS.EMAIL}`}>
          <span aria-label={SOCIAL_LINKS.EMAIL}>MAIL</span>
        </a>
      ) : null}
      {SOCIAL_LINKS.SHOW_RSS ? (
        <a target="_blank" href={BASE + "/rss.xml"}>
          <span aria-label="RSS feed">RSS</span>
        </a>
      ) : null}
    </div>
    <p class="mt-8 text-center text-sm/6 text-base-500 [&_a]:!text-base-500 hover:[&_a]:!text-base-200 md:order-1 md:mt-0 text-pretty">
      &copy; {today.getFullYear()}
      {NAME}. {LICENSE}
    </p>
  </div>
</footer>
