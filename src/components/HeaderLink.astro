---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { active: boolean };

const { href, class: className, active, ...props } = Astro.props;
---

<a
  href={href}
  class:list={[
    className,
    active
      ? "text-base-900 hover:text-base-700 dark:text-base-50 dark:hover:text-base-200"
      : "text-base-700 hover:text-base-900 dark:text-base-400 dark:hover:text-base-200",
  ]}
  {...props}
>
  <slot />
</a>
