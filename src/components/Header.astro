---
import {
  BASE,
  SEARCH_ENABLED,
  SITE_NAME,
  SITE_TITLE,
} from "../config.ts";
import CodeCopyButton from "./CodeCopyButton.astro";

import CommandPalette from "./search/CommandPalette.svelte";
import Search from "./search/Search.svelte";

---

<header>
  <nav
    class="grid grid-cols-[1fr_auto_1fr] items-center p-6 lg:px-8"
    aria-label="Global"
  >
    <div></div>
    <a href={BASE + "/"} class="p-1.5">
      <span class="sr-only">go to home</span>
      <span class="font-bold uppercase text-base text-base-950 dark:text-base-50">
        {SITE_NAME || SITE_TITLE}
      </span>
    </a>
    <div class="justify-self-end">
      {SEARCH_ENABLED ? <Search client:visible /> : null}
    </div>
  </nav>
</header>

<CommandPalette client:load />
<CodeCopyButton />
